<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Necesario con hardened runtime (obligatorio para notarizar): sin esto la app
	  no puede enviar Apple Events y el módulo de reproducción deja de leer Spotify
	  y Música, sin aviso.
	-->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
